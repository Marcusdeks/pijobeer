# ==============================================================
#  Variables de entorno del servidor
#
#  Copia este archivo como ".env" (en esta misma carpeta) y ajústalo.
#  ".env" NO se sube a Git; este ".env.example" sí, sin secretos reales.
#  Todas se validan al arrancar en src/config/env.ts: si falta alguna
#  obligatoria, el servidor no arranca y dice cuál.
# ==============================================================

# development | production | test
NODE_ENV=development

# Puerto en el que escucha la API
PORT=3000

# Conexión a PostgreSQL. Estos valores coinciden con docker-compose.yml (puerto 5433)
DATABASE_URL="postgresql://pijobeer:pijobeer_dev@localhost:5433/pijobeer?schema=public"

# Clave con la que se FIRMAN los tokens de sesión. Quien la conozca puede
# hacerse pasar por cualquier usuario: larga, aleatoria y secreta.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-verdad

# Días que dura la sesión antes de tener que volver a iniciarla
SESSION_TTL_DAYS=7

# URL del frontend. Se usa para construir el enlace de verificación del email
CLIENT_URL=http://localhost:5173

# Coste de bcrypt: más alto = más seguro pero más lento (12 ≈ 250 ms por hash)
BCRYPT_ROUNDS=12

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Juego admin ----
# Clave de la API de Claude (console.anthropic.com) para el agente de "juego admin".
# Opcional: sin ella el agente no responde, pero el panel manual de trucos funciona igual.
ANTHROPIC_API_KEY=

# Cuenta de administrador que crea "npm run db:seed". Pon aquí la tuya.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
